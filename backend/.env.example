# Copy this file to ".env" and change values as needed.

# MongoDB connection. Local install default shown.
# For MongoDB Atlas use: mongodb+srv://<user>:<password>@<cluster>/...
# Use "mongomock://" to run without MongoDB (data is lost on restart).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=agrisense

PORT=5000
FLASK_DEBUG=1

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Insert sample fields/history/settings when the database is empty
SEED_ON_START=1

# Weather: "live" uses the free Open-Meteo API (no key needed) and falls back
# to sample data if it can't be reached. "sample" always uses sample data.
WEATHER_SOURCE=live
# Location used when a field has no coordinates (Nagpur)
DEFAULT_LAT=21.1458
DEFAULT_LON=79.0882

# Optional: path to a trained model file. If empty or missing, the
# rule-based engine is used. See README.
MODEL_PATH=
